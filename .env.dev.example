# docker-compose.dev.yml uchun namuna. Nusxa: .env.dev (git'ga kirmaydi), chmod 600.
# Qiymatlarni o'zingiz yarating, masalan: openssl rand -base64 32

POSTGRES_DB=kiddo_dev
POSTGRES_USER=kiddo_dev
POSTGRES_PASSWORD=

DB_DATABASE=kiddo_dev
DB_USERNAME=kiddo_dev
DB_PASSWORD=

# base64:<32 bayt>
APP_KEY=

# DEV TEST MODE: php artisan kiddo:dev-accounts (admin / bogcha1 / tarbiyachi1).
# Faqat APP_ENV=local va baza nomi KIDDO_DEV_TEST_DATABASE bo'lsa ishlaydi. Production'da yoqmang.
KIDDO_DEV_TEST_MODE=false
KIDDO_DEV_TEST_DATABASE=kiddo_dev
KIDDO_DEV_TEST_PASSWORD=

# Ixtiyoriy alohida DEV Super Admin (kiddo:dev-accounts bir marta yaratadi). Parol kamida 12 belgi.
KIDDO_DEV_SUPERADMIN_USERNAME=
KIDDO_DEV_SUPERADMIN_PASSWORD=

# Telegram: landing DEMO arizalari shu chatga yuboriladi (faqat backend; frontendga chiqmaydi).
# Bo'sh qolsa — arizalar faqat bazada saqlanadi va Super Admin panelida ko'rinadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_ATTEMPTS=5

# KIDDO obuna/tarif/to'lov API'si (MVP'da o'chiq; frontend: src/lib/features.ts)
BILLING_ENABLED=false
