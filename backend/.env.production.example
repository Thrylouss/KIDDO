APP_NAME=KIDDO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tashkent
APP_URL=https://api.kiddo.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=uz_UZ

# Kod konteynerga faqat o'qish uchun (:ro) ulanadi; loglar faylga emas, stderr'ga.
# stderr → `docker compose logs php scheduler` orqali ko'rinadi.
# warning: Telegram xatolari (error) va «Telegram sozlanmagan» (warning) ogohlantirishlari ham yoziladi.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Baza ulanishi (DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD) docker-compose.prod.yml orqali ROOT `.env`
# faylidan beriladi va bu yerdagidan ustun turadi — parolni ikki joyda saqlamang, bu yerda bo'sh qoldiring.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kiddo
DB_USERNAME=kiddo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.kiddo.uz

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_DATABASE_TABLE=cache

# MVP'da ilova email yubormaydi (kodda Mail/Notification yo'q). SMTP kerak bo'lganda smtp ga o'zgartiring.
MAIL_MAILER=log
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@kiddo.uz"
MAIL_FROM_NAME="${APP_NAME}"

# CORS: faqat shu manzilga ruxsat (production'da localhost qo'shilmaydi)
FRONTEND_URL=https://kiddo.uz
SANCTUM_STATEFUL_DOMAINS=kiddo.uz

# Error monitoring — Sentry loyihasi DSN'i. Ishlatilmasa bo'sh qoldiring (placeholder qoldirilmasin).
# SENTRY_SEND_DEFAULT_PII standart false — shaxsiy ma'lumotlar Sentry'ga yuborilmaydi.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

# KIDDO obuna/tarif/to'lov bo'limlari (MVP'da o'chiq). true qilinsa frontend'da ham
# frontend/src/lib/features.ts → BILLING_ENABLED = true qilinishi kerak.
BILLING_ENABLED=false

# Telegram: landing DEMO arizalari shu chatga yuboriladi (faqat backend; frontendga chiqmaydi).
# Bo'sh qolsa — arizalar faqat bazada saqlanadi va Super Admin panelida ko'rinadi.
# Tekshirish: php artisan kiddo:telegram:status [--send-test]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_ATTEMPTS=5

# Faqat lokal ishlab chiqish uchun (KIDDO_DEV_TEST_MODE, KIDDO_DEV_TEST_PASSWORD, KIDDO_DEV_SUPERADMIN_*) —
# production'da BERILMASIN. Dev buyruqlari (kiddo:dev:*) baribir faqat APP_ENV=local da ishlaydi.
