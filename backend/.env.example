APP_NAME=KIDDO
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tashkent
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=uz_UZ

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kiddo
DB_USERNAME=kiddo
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_DATABASE_TABLE=cache

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kiddo.uz"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Error monitoring — leave empty in local development
SENTRY_LARAVEL_DSN=

# Telegram: landing DEMO arizalari shu chatga yuboriladi (faqat backend; frontendga chiqmaydi).
# Bo'sh qolsa — arizalar faqat bazada saqlanadi va Super Admin panelida ko'rinadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_ATTEMPTS=5

# KIDDO obuna/tarif/to'lov API'si (MVP'da o'chiq; frontend: src/lib/features.ts)
BILLING_ENABLED=false
