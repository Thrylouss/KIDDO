# KIDDO — serverdagi ROOT `.env` uchun namuna (docker-compose.prod.yml shu fayldan o'qiydi).
# Nusxalash: cp .env.production.example .env && chmod 600 .env  — haqiqiy `.env` Git'ga kiritilmaydi.
# Laravel'ning boshqa sozlamalari: backend/.env (namuna: backend/.env.production.example).

# ─── Baza (postgres servisi va Laravel uchun yagona manba) ─────────────
# Kuchli parol: openssl rand -base64 32
DB_PASSWORD=
DB_DATABASE=kiddo
DB_USERNAME=kiddo
# Alohida/boshqariladigan PostgreSQL ishlatilsa — uning manzili (bo'lmasa o'zgartirmang)
DB_HOST=postgres
DB_PORT=5432

# ─── Frontend build (ochiq qiymatlar, secret emas; o'zgartirilsa frontend qayta build qilinadi) ─
# Oxirida /api bo'lishi shart: kod so'rovlarni ${NEXT_PUBLIC_API_URL}/v1/... ga yuboradi
NEXT_PUBLIC_API_URL=https://api.kiddo-sad.uz/api
# Landing sahifadagi aloqa ma'lumotlari (bo'sh — ko'rsatilmaydi)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_ADDRESS=
# Faqat haqiqiy, tasdiqlangan do'kon havolalari (bo'sh — /ota-ona sahifasida tugma ko'rsatilmaydi)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
